---
import SEO from '../components/SEO.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import MobileBar from '../components/sections/MobileBar.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { instagramProfile } from '../data/instagram';
import { company } from '../data/company';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  transparentHeader?: boolean;
}

const { title, description, image, noindex, transparentHeader = false } = Astro.props;

// LocalBusiness JSON-LD. Alleen velden die we ook echt kennen —
// geen verzonnen openingsuren of coördinaten.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': Astro.site ? new URL('/#bedrijf', Astro.site).href : undefined,
  name: company.name,
  legalName: company.legalName,
  description: 'Aannemer voor kabelwerken, bouw & renovatie, dakwerken, gevelwerken, pleisterwerken en asbestverwijdering in Oost- en West-Vlaanderen, vanuit Lokeren.',
  telephone: company.phoneHref.replace('tel:', ''),
  email: company.email,
  url: Astro.site?.href,
  image: Astro.site ? new URL('/og-image.jpg', Astro.site).href : undefined,
  sameAs: [instagramProfile.href],
  hasMap: company.mapsHref,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    postalCode: company.postalCode,
    addressLocality: company.city,
    addressRegion: company.region,
    addressCountry: 'BE',
  },
  areaServed: company.areaServed,
  vatID: company.vat.replace('BTW ', ''),
};
---

<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1E1E1E" />
    <!-- Icoon uit het logo van de klant (public/logo.jpg): de B met stelling; het volledige logo is op 16–32 px onleesbaar. -->
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <SEO title={title} description={description} image={image} noindex={noindex} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    {
      /* Synchroon en vóór de eerste render: zonder deze klasse blijft
         [data-reveal] gewoon zichtbaar (zie global.css). Zo is er nooit
         verborgen content als JS uitblijft of traag laadt. */
    }
    <script is:inline>
      document.documentElement.classList.add('js-anim');
    </script>
  </head>
  <body class="bg-white pb-16 nav:pb-0">
    <Header transparent={transparentHeader} />
    <main>
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <CookieBanner />
  </body>
</html>
