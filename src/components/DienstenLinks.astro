---
// Interne links naar de dienstpagina's, onderaan de subpagina's.
// Op een dienstpagina: `huidig` laat de dienst zelf weg.
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { getServices } from '../lib/content';

interface Props {
  eyebrow: string;
  titel: string;
  huidig?: string;
}

const { eyebrow, titel, huidig } = Astro.props;
const services = (await getServices()).filter((service) => service.id !== huidig);
---

<section class="bg-neutral-50 py-section lg:py-section-lg">
  <Container>
    <SectionHeading {eyebrow}>{titel}</SectionHeading>
    <ul class="mt-10 grid grid-cols-1 gap-4 nav:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <li>
            <a
              href={`/${service.id}`}
              class="group flex h-full items-start gap-4 rounded-card border border-neutral-100 bg-white p-5 transition-all duration-200 hover:-translate-y-1 hover:border-gold hover:shadow-[0_16px_32px_rgba(30,30,30,0.10)]"
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-ink text-gold">
                <Icon name={service.data.icon} class="h-5 w-5" />
              </span>
              <span>
                <span class="block text-[17px] font-bold leading-snug text-heading">{service.data.title}</span>
                <span class="mt-1 block text-[14px] leading-relaxed text-neutral-500">{service.data.shortDescription}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
