---
// Eén icoonfamilie voor de hele site: 24-grid lijnstijl, ronde uiteinden.
// Inline SVG — geen icoonbibliotheek nodig voor een handvol glyphs.
export type IconName =
  | 'phone'
  | 'mail'
  | 'pin'
  | 'clock'
  | 'check'
  | 'x'
  | 'plus'
  | 'minus'
  | 'chevron-down'
  | 'arrow-right'
  | 'menu'
  | 'star'
  | 'move-horizontal'
  | 'cable'
  | 'building'
  | 'roof'
  | 'wall'
  | 'trowel'
  | 'shield'
  | 'instagram'
  | 'play';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'phone' && (
      <path d="M7 3.5H4.5a1 1 0 0 0-1 1c0 8.837 7.163 16 16 16a1 1 0 0 0 1-1V17c0-.46-.317-.86-.766-.966l-3.5-.823a1 1 0 0 0-1.023.35l-1.3 1.62a13.06 13.06 0 0 1-5.591-5.591l1.62-1.3a1 1 0 0 0 .35-1.023l-.823-3.5A1 1 0 0 0 7 3.5Z" />
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 6.5 8 6 8-6" />
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M19 10.5c0 6-7 11-7 11s-7-5-7-11a7 7 0 1 1 14 0Z" />
        <circle cx="12" cy="10.5" r="2.4" />
      </>
    )
  }
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5V12l3 2" />
      </>
    )
  }
  {
    name === 'check' && <path d="m4.5 12.5 5 5 10-11" />
  }
  {
    name === 'x' && <path d="M6 6l12 12M18 6 6 18" />
  }
  {
    name === 'plus' && <path d="M12 5v14M5 12h14" />
  }
  {
    name === 'minus' && <path d="M5 12h14" />
  }
  {
    name === 'chevron-down' && <path d="m5.5 8.5 6.5 7 6.5-7" />
  }
  {
    name === 'arrow-right' && <path d="M4.5 12h15m0 0-6-6m6 6-6 6" />
  }
  {
    name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />
  }
  {
    name === 'star' && (
      <path
        d="m12 3.5 2.66 5.61 6.09.75-4.5 4.28 1.18 6.11L12 17.2l-5.43 3.05 1.18-6.11-4.5-4.28 6.09-.75L12 3.5Z"
        fill="currentColor"
        stroke="none"
      />
    )
  }
  {
    name === 'move-horizontal' && (
      <path d="M6.5 8.5 3 12l3.5 3.5M17.5 8.5 21 12l-3.5 3.5M3 12h18" />
    )
  }
  {
    name === 'cable' && (
      <>
        <path d="M6 3.5v4a3.5 3.5 0 0 0 3.5 3.5h5A3.5 3.5 0 0 1 18 14.5v6" />
        <circle cx="6" cy="3.5" r="1.6" />
        <circle cx="18" cy="20.5" r="1.6" />
      </>
    )
  }
  {
    name === 'building' && (
      <>
        <rect x="5" y="3.5" width="14" height="17" rx="1.2" />
        <path d="M9 8h2M13 8h2M9 12h2M13 12h2M9 16h2M13 16h2" />
      </>
    )
  }
  {
    name === 'roof' && (
      <>
        <path d="M3.5 12 12 4.5 20.5 12" />
        <path d="M5.5 10.5V19h13v-8.5" />
      </>
    )
  }
  {
    name === 'wall' && (
      <>
        <rect x="3.5" y="4.5" width="17" height="15" rx="1" />
        <path d="M3.5 9.5h17M3.5 14.5h17M9 4.5v5M15 9.5v5M9 14.5v5" />
      </>
    )
  }
  {
    name === 'trowel' && (
      <path d="M4 20 15.5 8.5a2.5 2.5 0 0 0 0-3.5 2.5 2.5 0 0 0-3.5 0L4 13.5 4 20h6.5" />
    )
  }
  {
    name === 'shield' && (
      <>
        <path d="M12 3.5 19 6v6c0 5-3 8-7 9.5-4-1.5-7-4.5-7-9.5V6l7-2.5Z" />
        <path d="m9 12 2 2 4-4" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
      </>
    )
  }
  {
    name === 'play' && <path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor" />
  }
</svg>
