---
// Toont een echte foto (src) zodra die er is; zonder src blijft dit de
// grijze plaatshouder met het label erop. Vaste ratio in beide gevallen
// zodat de lay-out niet verschuift zodra media wordt toegevoegd/vervangen.
interface Props {
  label: string;
  ratio: '4:3' | '3:4' | '16:9' | '1:1';
  src?: string;
  class?: string;
}

const { label, ratio, src, class: className = '' } = Astro.props;

const ratioClass: Record<Props['ratio'], string> = {
  '4:3': 'aspect-[4/3]',
  '3:4': 'aspect-[3/4]',
  '16:9': 'aspect-video',
  '1:1': 'aspect-square',
};
---

{
  src ? (
    <img
      src={src}
      alt={label}
      loading="lazy"
      class:list={['overflow-hidden rounded-card object-cover', ratioClass[ratio], className]}
    />
  ) : (
    <div
      class:list={[
        'flex items-center justify-center overflow-hidden rounded-card border border-neutral-300/70 bg-neutral-300 text-center',
        ratioClass[ratio],
        className,
      ]}
      role="img"
      aria-label={label}
    >
      <span class="px-6 text-sm font-medium uppercase tracking-wide text-neutral-700">{label}</span>
    </div>
  )
}
