---
import Icon from '../Icon.astro';
import { company } from '../../data/company';
---

<div class="fixed inset-x-0 bottom-0 z-40 flex h-16 border-t border-neutral-100 bg-white shadow-[0_-6px_18px_rgba(30,30,30,0.10)] nav:hidden">
  <a href={company.phoneHref} class="group flex flex-1 items-center justify-center gap-2 border-r border-neutral-100 text-[15px] font-bold text-heading">
    <Icon name="phone" class="h-4 w-4 group-hover:animate-[phone-ring_0.5s_ease-in-out]" />
    Bel ons
  </a>
  <a href="/#contact" class="flex flex-[1.4] items-center justify-center gap-2 bg-gold text-[15px] font-bold text-ink">
    Gratis offerte
  </a>
</div>
