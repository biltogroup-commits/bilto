---
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';
import { steps } from '../../data/steps';
---

<section id="werkwijze" class="scroll-mt-[100px] bg-white py-section lg:py-section-lg">
  <Container>
    <div class="pb-12 lg:pb-16" data-reveal>
      <SectionHeading eyebrow="Werkwijze">
        Zo verloopt een project
      </SectionHeading>
    </div>

    <div class="relative">
      <svg
        viewBox="0 0 1000 4"
        preserveAspectRatio="none"
        class="absolute inset-x-0 top-0 hidden h-[2px] w-full nav:block"
        aria-hidden="true"
      >
        <line x1="0" y1="2" x2="1000" y2="2" stroke="#D9D9D6" stroke-width="4" />
        <line
          data-werkwijze-line
          x1="0"
          y1="2"
          x2="1000"
          y2="2"
          stroke="#E5BB57"
          stroke-width="4"
          pathLength="100"
          stroke-dasharray="100"
          stroke-dashoffset="100"
        />
      </svg>

      <ol class="grid grid-cols-1 gap-8 pt-0 nav:grid-cols-5 nav:gap-8 nav:pt-8" data-reveal-group>
        {
          steps.map((step, index) => (
            <li
              data-reveal
              class="group relative flex flex-col gap-4 border-t border-neutral-300 pt-5 transition-transform duration-200 hover:-translate-y-1 nav:border-t-0 nav:pt-0"
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute -top-3 right-0 hidden select-none font-heading text-[88px] font-bold leading-none text-neutral-100 nav:block"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="relative flex flex-col gap-4">
                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-ink font-heading text-[18px] font-bold text-white transition-all duration-200 group-hover:scale-110 group-hover:bg-gold group-hover:text-ink group-hover:shadow-[0_10px_24px_var(--color-gold-glow)]">
                  {index + 1}
                </span>
                <h3 class="font-heading text-[20px] font-semibold text-heading">{step.title}</h3>
                <p class="text-[16px] leading-relaxed text-neutral-500">{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</section>
