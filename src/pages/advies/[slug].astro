---
// Adviesartikels: /advies/{slug}, één Markdown-bestand per artikel in
// src/content/artikels/. Bronnen en controledatum staan in de frontmatter.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import PageTitle from '../../components/PageTitle.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DienstenLinks from '../../components/DienstenLinks.astro';
import { getArtikels } from '../../lib/content';

export async function getStaticPaths() {
  const artikels = await getArtikels();
  return artikels.map((artikel) => ({ params: { slug: artikel.id }, props: { artikel } }));
}

const { artikel } = Astro.props;
const { Content } = await render(artikel);
const { title, description, gepubliceerd, gecontroleerd, diensten, bronnen } = artikel.data;

const datum = (d: Date) => d.toLocaleDateString('nl-BE', { day: 'numeric', month: 'long', year: 'numeric' });
const site = Astro.site ?? Astro.url;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: gepubliceerd.toISOString().slice(0, 10),
  dateModified: gecontroleerd.toISOString().slice(0, 10),
  inLanguage: 'nl-BE',
  mainEntityOfPage: new URL(`/advies/${artikel.id}`, site).href,
  author: { '@id': new URL('/#bedrijf', site).href },
  publisher: { '@id': new URL('/#bedrijf', site).href },
};
---

<BaseLayout title={`${title} — Bilto`} {description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <article class="bg-white py-section lg:py-section-lg">
    <Container class="max-w-2xl">
      <Breadcrumbs items={[{ label: 'Advies', href: '/advies' }, { label: title }]} class="mb-6" />
      <PageTitle>{title}</PageTitle>
      <p class="mt-4 text-[14px] text-neutral-500">
        Gecontroleerd op <time datetime={gecontroleerd.toISOString().slice(0, 10)}>{datum(gecontroleerd)}</time>{' '}
        aan de hand van de officiële bronnen onderaan.
      </p>
      <div class="prose-bilto mt-8 text-[16px] leading-relaxed text-neutral-700">
        <Content />
      </div>

      <aside class="mt-12 rounded-card border border-neutral-100 bg-neutral-50 p-6">
        <h2 class="text-[18px] font-bold text-heading">Bronnen</h2>
        <ul class="mt-3 space-y-2 text-[15px] leading-relaxed">
          {
            bronnen.map((bron) => (
              <li>
                <a
                  href={bron.url}
                  rel="noopener"
                  class="font-semibold text-heading underline decoration-gold underline-offset-[3px]"
                >
                  {bron.titel}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-[13px] text-neutral-500">
          Regels en premies veranderen. Controleer de actuele voorwaarden altijd bij de bron voor je beslist.
        </p>
      </aside>
    </Container>
  </article>
  {diensten.length > 0 && <DienstenLinks eyebrow="Bilto helpt" titel="Diensten bij dit onderwerp" alleen={diensten} />}
</BaseLayout>
