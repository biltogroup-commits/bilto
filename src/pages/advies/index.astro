---
// Overzicht van de adviesartikels.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import PageTitle from '../../components/PageTitle.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { getArtikels } from '../../lib/content';

const artikels = await getArtikels();
---

<BaseLayout
  title="Advies over renovatie, asbest en premies — Bilto"
  description="Heldere uitleg over regels en premies bij bouwen en renoveren in Vlaanderen, op basis van officiële bronnen."
>
  <section class="bg-white py-section lg:py-section-lg">
    <Container class="max-w-3xl">
      <Breadcrumbs items={[{ label: 'Advies' }]} class="mb-6" />
      <PageTitle>Advies</PageTitle>
      <p class="mt-4 max-w-xl text-[18px] leading-relaxed text-neutral-700">
        Uitleg over regels en premies bij bouwen en renoveren in Vlaanderen, telkens met de officiële bronnen erbij.
      </p>
      <ul class="mt-10 grid gap-4">
        {
          artikels.map((artikel) => (
            <li>
              <a
                href={`/advies/${artikel.id}`}
                class="group flex items-start justify-between gap-6 rounded-card border border-neutral-100 bg-white p-6 transition-all duration-200 hover:-translate-y-1 hover:border-gold hover:shadow-[0_16px_32px_rgba(30,30,30,0.10)]"
              >
                <span>
                  <span class="block text-[20px] font-bold leading-snug text-heading">{artikel.data.title}</span>
                  <span class="mt-2 block text-[15px] leading-relaxed text-neutral-500">{artikel.data.description}</span>
                </span>
                <Icon name="arrow-right" class="mt-1 h-5 w-5 shrink-0 text-neutral-500 transition-transform duration-200 group-hover:translate-x-1" />
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>
</BaseLayout>
